# ── Financial Modeling Prep (REQUIRED) ────────────────────────────────────────
# The only source of financial data. Agents reach FMP's remote MCP server
# (https://financialmodelingprep.com/mcp) through fmp_catalog and fmp_call.
# Endpoint availability follows your plan: Starter covers statements, charts,
# quotes, analyst data, news, economics, insider and congressional trades and
# technical indicators. ESG and earnings transcripts need Ultimate; form13F and
# COT need Premium. A gated endpoint returns kind="plan_denied", never a crash.
FMP_API_KEY=your_fmp_api_key

# ── OpenRouter (REQUIRED) ─────────────────────────────────────────────────────
# Powers every agent. Which model each role uses is set in equity_mcp/roles.py
# (DEFAULT_MODEL, and per-agent overrides in AGENT_MODELS).
OPENROUTER_API_KEY=sk-or-...
# Optional app-attribution headers shown on your OpenRouter activity page:
# OPENROUTER_APP_URL=https://github.com/your-org/equity-researcher
# OPENROUTER_APP_TITLE=equity-researcher

# ── Web Search (optional) ─────────────────────────────────────────────────────
# Backs web_search, which agents use for qualitative evidence FMP doesn't carry.
# Without a Brave key it falls back to scraping DuckDuckGo, which is unreliable.
BRAVE_API_KEY=your_brave_search_api_key

# ── Workspace (optional) ──────────────────────────────────────────────────────
# Each run writes fetched payloads and generated scripts to runs/<SYMBOL>_<ts>/.
# EQ_WORKSPACE_ROOT moves the parent directory; EQ_WORKSPACE pins one exact
# workspace, which is mainly useful for inspecting tools outside a run.
# EQ_WORKSPACE_ROOT=runs
# EQ_WORKSPACE=
