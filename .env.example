# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Financial Modeling Prep ───────────────────────────────────────────────────
# Feeds the Supabase pipeline, and backs every db.py tool via FMP's remote MCP
# server (https://financialmodelingprep.com/mcp) when the database can't serve
# a query. Without it, agents get empty results whenever Supabase is down.
FMP_API_KEY=your_fmp_api_key

# ── Web Search (choose one) ───────────────────────────────────────────────────
BRAVE_API_KEY=your_brave_search_api_key
# SERP_API_KEY=your_serpapi_key

# ── News ──────────────────────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_org_key

# ── FRED (Federal Reserve Economic Data — free at fred.stlouisfed.org) ────────
FRED_API_KEY=your_fred_api_key

# ── SEC EDGAR (no key required, but set a descriptive User-Agent) ─────────────
SEC_USER_AGENT=equity-researcher/0.1 contact@yourcompany.com
