# ── Database (currently unused) ───────────────────────────────────────────────
# The tools in equity_mcp/tools/db.py read from FMP, not from Postgres, so a run
# needs nothing here. Kept for the ingestion pipeline this will eventually feed.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Powers every agent. Which model each role uses is set in equity_mcp/roles.py
# (DEFAULT_MODEL, and per-agent overrides in AGENT_MODELS).
OPENROUTER_API_KEY=sk-or-v1-...
# Optional app-attribution headers shown on your OpenRouter activity page:
# OPENROUTER_APP_URL=https://github.com/your-org/equity-researcher
# OPENROUTER_APP_TITLE=equity-researcher

# ── Anthropic (only needed for the --legacy pipeline) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Financial Modeling Prep (required) ────────────────────────────────────────
# Backs all 12 tools in tools/db.py — statements, prices, dividends, earnings,
# estimates, screener — and every news tool in tools/external/news.py.
# Needs the Starter plan or above; press-releases and quarterly key-metrics
# need more again and return plan_denied on Starter.
FMP_API_KEY=your_fmp_api_key

# ── Web Search (set one; Brave wins if both are set) ──────────────────────────
# Without one of these, web_search falls back to a DuckDuckGo scrape that is
# blocked as often as not — treat that as having no web search at all.
BRAVE_API_KEY=your_brave_search_api_key
# SERP_API_KEY=your_serpapi_key

# ── FRED (Federal Reserve Economic Data — free at fred.stlouisfed.org) ────────
FRED_API_KEY=your_fred_api_key

# ── SEC EDGAR (no key required, but set a descriptive User-Agent) ─────────────
SEC_USER_AGENT=equity-researcher/0.1 contact@yourcompany.com
