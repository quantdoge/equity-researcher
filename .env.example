# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Powers every agent. Which model each role uses is set in equity_mcp/roles.py
# (DEFAULT_MODEL, and per-agent overrides in AGENT_MODELS).
OPENROUTER_API_KEY=sk-or-...
# Optional app-attribution headers shown on your OpenRouter activity page:
# OPENROUTER_APP_URL=https://github.com/your-org/equity-researcher
# OPENROUTER_APP_TITLE=equity-researcher

# ── Financial Modeling Prep ───────────────────────────────────────────────────
# Feeds the Supabase pipeline, and backs every db.py tool via FMP's remote MCP
# server (https://financialmodelingprep.com/mcp) when the database can't serve
# a query. Without it, agents get empty results whenever Supabase is down.
# Also the primary source for every news tool, via the stable News API. Note the
# /stable/news/* endpoints need a paid FMP tier — on a plan without them FMP
# answers 402 and the news tools fall through to NEWS_API_KEY, then web search.
FMP_API_KEY=your_fmp_api_key

# ── Web Search (choose one) ───────────────────────────────────────────────────
BRAVE_API_KEY=your_brave_search_api_key
# SERP_API_KEY=your_serpapi_key

# ── News (optional fallback — FMP_API_KEY above is the primary source) ────────
NEWS_API_KEY=your_newsapi_org_key

# ── FRED (Federal Reserve Economic Data — free at fred.stlouisfed.org) ────────
FRED_API_KEY=your_fred_api_key

# ── SEC EDGAR (no key required, but set a descriptive User-Agent) ─────────────
SEC_USER_AGENT=equity-researcher/0.1 contact@yourcompany.com
